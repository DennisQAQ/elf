mixed-port: 7890
allow-lan: true
mode: rule
log-level: info
external-controller: 127.0.0.1:9090

# =====================
# DNS 防污染
# =====================
dns:
  enable: true
  listen: 0.0.0.0:1053
  enhanced-mode: fake-ip

  nameserver:
    - https://223.5.5.5/dns-query
    - https://119.29.29.29/dns-query

  fallback:
    - https://1.1.1.1/dns-query
    - https://8.8.8.8/dns-query

  fallback-filter:
    geoip: true
    geoip-code: CN

# =====================
# 代理节点
# =====================
proxies:

  # ===== 美国 Reality =====
  - name: SanJose-Reality
    type: vless
    server: sanjose-reality.jknas.top
    port: 443
    uuid: 06560f2b-4975-4104-bc3f-79f8015ab65e
    network: tcp
    tls: true
    flow: xtls-rprx-vision
    servername: www.microsoft.com
    reality-opts:
      public-key: oEyKVQL52TUNvHCvx2KxVhZ_xTyncT40dMB5ayJLqUE
      short-id: 6ba85179e30d4fc2
    client-fingerprint: chrome
    encryption: none

  # ===== 日本 HY2 =====
  - name: Tokyo-HY2
    type: hysteria2
    server: tokyo-hy2.jknas.top
    port: 443
    password: i6FTL4gX9RphDT4ou3rO
    sni: tokyo-hy2.jknas.top
    obfs: salamander

  # ===== 日本 Reality =====
  - name: Tokyo-Reality
    type: vless
    server: tokyo-reality.jknas.top
    port: 443
    uuid: 3cfab023-0140-450c-a280-3bffffef1305
    network: tcp
    tls: true
    flow: xtls-rprx-vision
    servername: www.microsoft.com
    reality-opts:
      public-key: FVCVxzI7715I6roRC2AzWA45EI3O1R-pA4f55k8AlS8
      short-id: 6ba85179e30d4fc2
