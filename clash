# =====================
# 代理组（智能选路）
# =====================
proxy-groups:

  - name: PROXY
    type: select
    proxies:
      - AUTO-GLOBAL
      - AUTO-JP
      - AUTO-US
      - AUTO-SG
      - DIRECT

  - name: AUTO-GLOBAL
    type: url-test
    url: http://www.gstatic.com/generate_204
    interval: 300
    tolerance: 50
    proxies:
      - SanJose-Reality
      - Tokyo-Reality
      - Tokyo-HY2
      - EdgeTunnel-WS

  - name: AUTO-JP
    type: url-test
    url: http://www.gstatic.com/generate_204
    interval: 300
    tolerance: 50
    proxies:
      - Tokyo-Reality
      - Tokyo-HY2

  - name: AUTO-US
    type: url-test
    url: http://www.gstatic.com/generate_204
    interval: 300
    tolerance: 50
    proxies:
      - SanJose-Reality

  - name: AUTO-SG
    type: url-test
    url: http://www.gstatic.com/generate_204
    interval: 300
    tolerance: 50
    proxies:
      - EdgeTunnel-WS

# =====================
# 分流规则（核心）
# =====================
rules:

  # ===== 本地 =====
  - IP-CIDR,127.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,10.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,172.16.0.0/12,DIRECT,no-resolve
  - IP-CIDR,192.168.0.0/16,DIRECT,no-resolve
  - IP-CIDR,100.64.0.0/10,DIRECT,no-resolve

  # ===== 中国直连 =====
  - GEOIP,CN,DIRECT,no-resolve
  - GEOSITE,cn,DIRECT

  # ===== 日本 =====
  - GEOIP,JP,AUTO-JP,no-resolve
  - GEOSITE,jp,AUTO-JP

  # ===== 美国 =====
  - GEOIP,US,AUTO-US,no-resolve
  - GEOSITE,us,AUTO-US

  # ===== 新加坡 =====
  - GEOIP,SG,AUTO-SG,no-resolve

  # ===== AI / Google / GitHub =====
  - GEOSITE,openai,PROXY
  - GEOSITE,google,PROXY
  - GEOSITE,github,PROXY
  - GEOSITE,youtube,PROXY

  # ===== 默认 =====
  - MATCH,PROXY
